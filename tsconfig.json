{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "void/env",
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    "env.ts",
    "void.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "src",
    "pages",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db",
    "container",
    "tests",
    "scripts"
  ]
}
