# ローカル開発用。`cp env.example .env` で使う（void/env は .env.example 等のルート .env.* を拒否するため、ドット無しの名前にしている）。本番値は `void secret put` で設定する。
AUTH_MODE=dev
# AUTH_MODE=access のときに必要
# ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# ACCESS_AUD=
# 許可するメールアドレス（カンマ区切り）。AUTH_MODE=access のとき、空なら誰も許可しない
# ALLOWED_EMAILS=you@example.com
R2_RETENTION_DAYS=30
